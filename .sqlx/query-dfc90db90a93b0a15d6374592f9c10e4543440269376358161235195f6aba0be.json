{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT DISTINCT p.id, p.title\n            FROM tags t\n            JOIN tag_posts tp ON tp.tag_id = t.id\n            JOIN posts p ON p.id = tp.post_id\n            WHERE t.name ILIKE '%' || $1::TEXT || '%'\n            ORDER BY p.id DESC\n            LIMIT $2 OFFSET $3;\n            ",
