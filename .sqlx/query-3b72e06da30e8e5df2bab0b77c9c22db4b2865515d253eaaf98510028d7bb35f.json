  "query": "\n            WITH qs AS (\n                SELECT q FROM\n                unnest($1::halfvec[]) AS _(q)\n            )\n            SELECT id, name, width, height\n            FROM images i\n            CROSS JOIN qs\n            ORDER BY i.dinov3_embedding <=> qs.q\n            LIMIT $2 OFFSET $3\n            ",
