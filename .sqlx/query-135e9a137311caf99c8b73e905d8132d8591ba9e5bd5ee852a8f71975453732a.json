  "query": "\n            SELECT i.id, i.name, i.width, i.height\n            FROM UNNEST($1::BIGINT[]) WITH ORDINALITY AS c(id, ord)\n            JOIN images i ON i.id = c.id\n            ORDER BY c.ord\n            ",
