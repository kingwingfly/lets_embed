{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                q.ord AS \"ord!\",\n                i.id,\n                i.name,\n                i.width,\n                i.height\n            FROM unnest($1::halfvec[]) WITH ORDINALITY AS q(vec, ord)\n            CROSS JOIN LATERAL (\n                SELECT id, name, width, height, clip_embedding <=> q.vec AS dist\n                FROM images\n                ORDER BY dist\n                LIMIT $2 OFFSET $3\n            ) AS i\n            ORDER BY q.ord, i.dist;\n            ",
