{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT p.id, p.title\n            FROM authors a\n            JOIN author_posts ap ON ap.author_id = a.id\n            JOIN posts p ON p.id = ap.post_id\n            WHERE a.name ILIKE '%' || $1::TEXT || '%'\n            ORDER BY p.id DESC\n            LIMIT $2 OFFSET $3;\n            ",
