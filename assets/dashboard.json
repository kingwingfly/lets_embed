{
    "kind": "Dashboard",
    "metadata": {
        "name": "embed",
        "project": "default",
        "version": 0
    },
    "spec": {
        "display": {
            "name": "embed"
        },
        "panels": {
            "1779381413666z4808r55ypp": {
                "kind": "Panel",
                "spec": {
                    "display": {
                        "name": "gpu-memory"
                    },
                    "plugin": {
                        "kind": "TimeSeriesChart",
                        "spec": {
                            "legend": {
                                "position": "bottom"
                            },
                            "visual": {
                                "display": "line",
                                "lineWidth": 1.25,
                                "lineStyle": "solid",
                                "areaOpacity": 0,
                                "pointRadius": 2.75,
                                "connectNulls": false
                            },
                            "thresholds": {},
                            "yAxis": {
                                "show": true,
                                "label": "",
                                "format": {
                                    "unit": "bytes"
                                }
                            }
                        }
                    },
                    "queries": [
                        {
                            "kind": "TimeSeriesQuery",
                            "spec": {
                                "plugin": {
                                    "kind": "PrometheusTimeSeriesQuery",
                                    "spec": {
                                        "query": "gpu_memory_B",
                                        "seriesNameFormat": "{{ hostname }}-{{ device_index }}"
                                    }
                                }
                            }
                        }
                    ]
                }
            },
